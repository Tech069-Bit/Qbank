name: Build QBank APK

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Prepare web files
        run: |
          mkdir -p www
          for f in index.html qr-vendor.js sync.js manifest.json icon-192.png icon-512.png; do
            if [ -f "$f" ]; then cp "$f" www/; fi
          done
          cat > www/native-bridge.js <<'EOF'
          (function () {
            var C = window.Capacitor;
            if (!C || !C.isNativePlatform || !C.isNativePlatform()) return;
            var P = C.Plugins || {};
            function toB64(blob) {
              return new Promise(function (res, rej) {
                var r = new FileReader();
                r.onload = function () { res(String(r.result).split(',')[1]); };
                r.onerror = rej;
                r.readAsDataURL(blob);
              });
            }
            async function saveAndShare(blob, name) {
              name = (name || 'file').replace(/[\\/:*?"<>|]+/g, '-');
              var data = await toB64(blob);
              var w = await P.Filesystem.writeFile({ path: name, data: data, directory: 'CACHE' });
              await P.Share.share({ title: name, url: w.uri, dialogTitle: 'Save or share file' });
            }
            function isFileLink(a) {
              return a && a.hasAttribute && a.hasAttribute('download') && /^(blob:|data:)/.test(a.href);
            }
            function handle(a) {
              fetch(a.href).then(function (r) { return r.blob(); })
                .then(function (b) { return saveAndShare(b, a.getAttribute('download')); })
                .catch(function (e) { console.warn('save failed', e); });
            }
            var origClick = HTMLAnchorElement.prototype.click;
            HTMLAnchorElement.prototype.click = function () {
              if (isFileLink(this)) { handle(this); return; }
              return origClick.apply(this, arguments);
            };
            document.addEventListener('click', function (e) {
              var a = e.target && e.target.closest ? e.target.closest('a[download]') : null;
              if (isFileLink(a)) { e.preventDefault(); handle(a); }
            }, true);
          })();
          EOF
          python3 - <<'EOF'
          p = 'www/index.html'
          s = open(p, encoding='utf-8').read()
          s = s.replace('</head>', '<script src="native-bridge.js"></script></head>', 1)
          open(p, 'w', encoding='utf-8').write(s)
          EOF

      - name: Create Capacitor project
        run: |
          npm init -y
          npm i @capacitor/core@6 @capacitor/cli@6 @capacitor/android@6 @capacitor/filesystem@6 @capacitor/share@6
          cat > capacitor.config.json <<'EOF'
          {
            "appId": "com.qbank.center",
            "appName": "QBank Center",
            "webDir": "www",
            "server": { "androidScheme": "https" }
          }
          EOF
          npx cap add android
          npx cap sync android

      - name: Build APK
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: QBank-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
